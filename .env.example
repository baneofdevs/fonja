# Copy to .env and fill in. .env is gitignored — never commit real values.

# Signing key for the internal JWT. Must be at least 32 bytes (HS256).
# Generate one with:  openssl rand -base64 48
FONJA_AUTH_JWT_SECRET=

# Google OAuth2 client, from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CyberPay. The integration key is also the webhook signing key — CyberPay HMAC-SHA512s every
# notification with it. Until it is set, /api/v1/donations/webhook rejects everything with a 503
# rather than trusting an unverifiable payment. Staging values come from your CyberPay dashboard.
CYBERPAY_BASE_URL=https://payment-api.staging.cyberpay.ng
CYBERPAY_INTEGRATION_KEY=
CYBERPAY_API_KEY=

# MySQL. Development defaults are applied if these are left unset.
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# Host port for the MySQL container. Change if a system MySQL already owns 3306.
MYSQL_HOST_PORT=3306
