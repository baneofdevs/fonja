# Copy to .env and fill in. .env is gitignored — never commit real values.

# Signing key for the internal JWT. Must be at least 32 bytes (HS256).
# Generate one with:  openssl rand -base64 48
FONJA_AUTH_JWT_SECRET=

# Google OAuth2 client, from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://api.example.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications over SMTP (Gmail at launch). Leave all three blank to run without email —
# every notification is then logged as SKIPPED instead of sent. For Gmail: turn on 2-step
# verification, create an App Password at https://myaccount.google.com/apppasswords, and use it
# here; the normal account password is rejected. Personal accounts are capped at ~500 mails/day.
FONJA_SMTP_HOST=smtp.gmail.com
FONJA_SMTP_PORT=587
FONJA_SMTP_USERNAME=
FONJA_SMTP_PASSWORD=
FONJA_SMTP_FROM_NAME=Fonja
# The frontend's public URL, used for the links in each email.
FONJA_APP_BASE_URL=https://app.example.com

# CyberPay. The integration key is also the webhook signing key — CyberPay HMAC-SHA512s every
# notification with it. Until it is set, /api/v1/donations/webhook rejects everything with a 503
# rather than trusting an unverifiable payment. Staging values come from your CyberPay dashboard.
CYBERPAY_BASE_URL=
CYBERPAY_INTEGRATION_KEY=
CYBERPAY_API_KEY=
CYBERPAY_WEBHOOK_URL=https://api.example.com/api/v1/donations/webhook
CYBERPAY_RETURN_URL=https://app.example.com/donation-complete?from=cyberpay

# CyberPay PayOut — a separate service from the one above, on a different host, with its own OAuth2
# client credentials and its own wallet. Leave any of these blank and automatic disbursement stays
# off: withdrawals are still reserved against a creator's earnings, they just wait for an admin.
#
# Staging payouts live at https://stagingserv.cyberpay.ng/payoutserv (from CyberPay, not from their
# Postman collection — the collection uses {{PAYOUT_BASE_URL}} everywhere and never defines it).
CYBERPAY_PAYOUT_BASE_URL=
# The OAuth2 server that issues the bearer token, i.e. the host CyberPay's docs call
# {{AUTHORIZATION_URL}} in "POST {{AUTHORIZATION_URL}}/oauth2/token". Also undefined in the
# collection, and shared with their Bills, Bank and Verification APIs — if you already have it for
# one of those, it is the same URL here. Do not include the /oauth2/token path.
CYBERPAY_PAYOUT_AUTH_URL=
CYBERPAY_PAYOUT_CLIENT_ID=
CYBERPAY_PAYOUT_CLIENT_SECRET=
# The wallet payouts are debited from. Confirm with CyberPay that this is the same balance donations
# settle into — if it is not, it has to be funded before any withdrawal can succeed.
CYBERPAY_PAYOUT_WALLET_CODE=
# FONJA_AUTH_LOGIN_REDIRECT_URI=https://app.example.com/auth/callback

# MySQL
DB_NAME=fonja
DB_USERNAME=fonja
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_SSL_MODE=REQUIRED
MYSQL_HOST_PORT=3307
SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:${MYSQL_HOST_PORT}/fonja?sslMode=${DB_SSL_MODE}&serverTimezone=UTC"

# Host port for the application. MySQL is private to the Compose network.
APP_HOST_PORT=8080
STORAGE_LOCAL_BASE_PATH=/data/fonja-documents
